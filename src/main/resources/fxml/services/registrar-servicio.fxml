<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="480.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.jala.university.presentation.controller.RegisterServiceController">
    <children>
        <VBox spacing="0.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

            <HBox style="-fx-background-color: #0C447C; -fx-padding: 12 16 12 16;"
                  alignment="CENTER_LEFT" spacing="12.0">
                <Label text="External Payment Module"
                       style="-fx-text-fill: #E6F1FB; -fx-font-size: 14; -fx-font-weight: bold;"/>
                <Label fx:id="labelSubtitle" text="Servicios registrados"
                       style="-fx-text-fill: #85B7EB; -fx-font-size: 11;"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnRegistrar" text="+ Registrar servicio"
                        onAction="#handleRegistrar"
                        style="-fx-background-color: #185FA5; -fx-text-fill: #E6F1FB;
                               -fx-font-size: 12; -fx-padding: 6 12 6 12;
                               -fx-background-radius: 6;"/>
            </HBox>

            <HBox style="-fx-background-color: #F1EFE8; -fx-padding: 6 12 6 12;"
                  alignment="CENTER_LEFT" spacing="8.0">
                <Label text="Mis servicios"
                       style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Label fx:id="labelConteo" text="0 servicios"
                       style="-fx-font-size: 11; -fx-text-fill: #888780;"/>
            </HBox>

            <Label fx:id="labelMensaje" text=""
                   style="-fx-background-color: #EAF3DE; -fx-text-fill: #3B6D11;
                          -fx-padding: 8 12 8 12; -fx-font-size: 12;"
                   maxWidth="1.7976931348623157E308"
                   VBox.vgrow="NEVER"/>

            <TableView fx:id="tableServicios" VBox.vgrow="ALWAYS"
                       style="-fx-font-size: 12;">
                <columns>
                    <TableColumn fx:id="colId" text="#" prefWidth="50"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
                    <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="240"/>
                    <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="150"/>
                </columns>
                <placeholder>
                    <Label text="No hay servicios disponibles."
                           style="-fx-text-fill: #888780;"/>
                </placeholder>
            </TableView>

        </VBox>
        <HBox spacing="10">
            <Button text="Cancelar"  onAction="#goBack"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-min-width: 120;"/>
        </HBox>
    </children>
</AnchorPane>
