<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15" styleClass="main-area"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.university.presentation.controller.GetServiceController">


    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Mis Servicios Vinculados" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TableView fx:id="servicesTable" VBox.vgrow="ALWAYS">
        <columns>

            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>

            <!-- DATOS PERSONALIZADOS (De la tabla user_services) -->
            <TableColumn fx:id="aliasColumn" text="Alias / Mi Nombre" prefWidth="150"/>
            <TableColumn fx:id="accountColumn" text="Nº de Cuenta" prefWidth="150"/>

            <!-- DATOS GLOBALES (Del JOIN con la tabla services) -->
            <TableColumn fx:id="nameColumn" text="Servicio" prefWidth="150"/>
            <TableColumn fx:id="providerColumn" text="Proveedor" prefWidth="150"/>
            <TableColumn fx:id="typeColumn" text="Categoría" prefWidth="100"/>
        </columns>
        <placeholder>
            <Label text="No tienes servicios vinculados todavía."/>
        </placeholder>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="refreshButton" text="Actualizar Lista" styleClass="quick-btn"/>
    </HBox>
</VBox>