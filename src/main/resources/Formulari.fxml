<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="360.0" prefWidth="480.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.jala.university.presentation.controller.Formulari">
    <children>
        <VBox spacing="0.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

            <HBox style="-fx-background-color: #F1EFE8; -fx-padding: 8 12 8 12;"
                  alignment="CENTER_LEFT">
                <Label text="Registrar nuevo servicio"
                       style="-fx-font-size: 13; -fx-font-weight: bold;"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Label text="EP1 · RF5 · HU22"
                       style="-fx-font-size: 11; -fx-text-fill: #888780;"/>
            </HBox>

            <VBox spacing="12.0"
                  style="-fx-padding: 16 16 16 16;" VBox.vgrow="ALWAYS">

                <VBox spacing="4.0">
                    <Label text="Nombre del servicio *"
                           style="-fx-font-size: 11; -fx-font-weight: bold;
                                  -fx-text-fill: #5F5E5A;"/>
                    <TextField fx:id="fieldNombre"
                               promptText="Ej: Luz Residencial, Internet Fibra"
                               style="-fx-font-size: 12;"/>
                    <Label fx:id="errorNombre" text=""
                           style="-fx-text-fill: #A32D2D; -fx-font-size: 11;"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Tipo de servicio *"
                           style="-fx-font-size: 11; -fx-font-weight: bold;
                                  -fx-text-fill: #5F5E5A;"/>
                    <ComboBox fx:id="comboTipo"
                              promptText="Selecciona un tipo"
                              maxWidth="1.7976931348623157E308"
                              style="-fx-font-size: 12;"/>
                    <Label fx:id="errorTipo" text=""
                           style="-fx-text-fill: #A32D2D; -fx-font-size: 11;"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Proveedor *"
                           style="-fx-font-size: 11; -fx-font-weight: bold;
                                  -fx-text-fill: #5F5E5A;"/>
                    <TextField fx:id="fieldProveedor"
                               promptText="Ej: Empresa Electrica Nacional"
                               style="-fx-font-size: 12;"/>
                    <Label fx:id="errorProveedor" text=""
                           style="-fx-text-fill: #A32D2D; -fx-font-size: 11;"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Categoria *"
                           style="-fx-font-size: 11; -fx-font-weight: bold;
                                  -fx-text-fill: #5F5E5A;"/>
                    <TextField fx:id="fieldCategoria"
                               promptText="Ej: Servicios Basicos, Telecomunicaciones"
                               style="-fx-font-size: 12;"/>
                    <Label fx:id="errorCategoria" text=""
                           style="-fx-text-fill: #A32D2D; -fx-font-size: 11;"/>
                </VBox>

            </VBox>

            <HBox spacing="8.0"
                  style="-fx-padding: 10 16 10 16;
                         -fx-border-color: #D3D1C7;
                         -fx-border-width: 1 0 0 0;"
                  alignment="CENTER_RIGHT">
                <Button fx:id="btnCancelar" text="Cancelar"
                        onAction="#handleCancelar"
                        style="-fx-font-size: 12;"/>
                <Button fx:id="btnConfirmar" text="Confirmar registro"
                        onAction="#handleConfirmar"
                        style="-fx-background-color: #185FA5; -fx-text-fill: #E6F1FB;
                               -fx-font-size: 12; -fx-padding: 6 12 6 12;
                               -fx-background-radius: 6;"/>
            </HBox>

        </VBox>
    </children>
</AnchorPane>

